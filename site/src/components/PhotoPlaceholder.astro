---
// site/src/components/PhotoPlaceholder.astro
interface Props {
  alt: string;
  src?: string;
  tint?: string;
}
const { alt, src, tint = 'var(--adult-bg)' } = Astro.props;
---
{src ? (
  <img class="photo" src={src} alt={alt} />
) : (
  <div class="photo photo-placeholder" style={`--tint: ${tint}`} aria-hidden="true"></div>
)}

<style>
  .photo {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-md);
    object-fit: cover;
  }
  .photo-placeholder {
    background: linear-gradient(135deg, var(--tint, var(--adult-bg)) 0%, var(--paper) 100%);
    transition: filter 150ms ease-out;
  }
  .photo-placeholder:hover {
    filter: brightness(0.95);
  }
</style>
