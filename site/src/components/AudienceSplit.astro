---
// site/src/components/AudienceSplit.astro
import Button from './Button.astro';
import '../styles/fonts-kids.css';

const panes = [
  {
    key: 'adult',
    title: 'Взрослым',
    text: 'Живопись, каллиграфия острым пером, скетчинг, керамика — индивидуально и в мини-группах.',
    href: '/vzroslym',
  },
  {
    key: 'kid',
    title: 'Детям',
    text: 'Лепка, пластилинография, брашпен 8+, керамика — с учётом возраста.',
    href: '/detyam',
  },
] as const;
---
<section class="audience-split">
  {panes.map((pane) => (
    <div class:list={["pane", pane.key, pane.key === 'kid' && 'kids']}>
      <div class="bar"></div>
      <h3>{pane.title}</h3>
      <p>{pane.text}</p>
      <Button href={pane.href} register={pane.key} size="compact" stretched>Выбрать направление</Button>
    </div>
  ))}
</section>

<style>
  .audience-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .pane {
    padding: var(--space-6) var(--space-5) var(--space-5);
    position: relative;
  }
  .pane .bar {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 6px;
  }
  .pane h3 {
    font-size: var(--text-h3);
    font-weight: 600;
    margin: 0 0 var(--space-2);
  }
  .pane p {
    font-size: var(--text-small);
    margin: 0 0 var(--space-4);
    max-width: 30ch;
  }
  /* Парный элемент перехода: разворачивается в intro-секцию раздела. */
  .pane.adult { background: var(--adult-bg); color: var(--ink); view-transition-name: adult-panel; }
  .pane.adult .bar { background: var(--adult); }

  .pane.kid { background: var(--kid-bg); color: #4A3B14; view-transition-name: kid-panel; }
  .pane.kid .bar { background: var(--kid); }

  /* Наведение на любую точку карточки триггерит :hover растянутой ссылки
     (её псевдоэлемент покрывает весь .pane) — здесь ловим это через :has()
     и даём обратную связь на всю карточку, а не только на маленькую кнопку. */
  .pane:has(.stretched:focus-visible) {
    outline: 3px solid currentColor;
    outline-offset: -3px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .pane {
      transition: transform 150ms ease-out;
    }
    .pane:has(.stretched:hover),
    .pane:has(.stretched:focus-visible) {
      transform: translateY(-2px);
    }
  }

  @media (max-width: 768px) {
    .audience-split { grid-template-columns: 1fr; }
  }
</style>
